"""PyTorch dataset wrapper over the validated filesystem index."""
from __future__ import annotations

import numpy as np
import torch
from PIL import Image
from torch.utils.data import Dataset

from .index import FrameRecord, split_records, window_records


class InfraredSequenceDataset(Dataset):
    def __init__(
        self,
        data_root: str,
        dataset: str,
        split: str,
        window_size: int = 5,
        image_size: int | None = 256,
        boundary: str = "replicate",
        val_fraction: float = 0.1,
        seed: int = 0,
        sequence: str | None = None,
    ):
        self.dataset_name = dataset
        self.split = split
        self.window_size = window_size
        self.image_size = image_size
        self.boundary = boundary
        self.root, self.records, self.split_info = split_records(
            data_root, dataset, split, val_fraction=val_fraction, seed=seed
        )
        if sequence is not None:
            self.records = [r for r in self.records if r.sequence.lower() == sequence.lower()]
            if not self.records:
                raise ValueError(f"Sequence {sequence!r} is not present in {dataset} split={split}")
        self.sequence_records: dict[str, list[FrameRecord]] = {}
        for record in self.records:
            self.sequence_records.setdefault(record.sequence, []).append(record)
        for sequence_records in self.sequence_records.values():
            sequence_records.sort(key=lambda r: (r.frame_index, r.name.lower()))
        self.window_by_record: dict[tuple[str, str], list[FrameRecord]] = {}
        for seq_records in self.sequence_records.values():
            for i, record in enumerate(seq_records):
                self.window_by_record[(record.sequence, record.name)] = window_records(
                    seq_records, i, window_size, boundary
                )

    def __len__(self) -> int:
        return len(self.records)

    def _load(self, path, is_mask: bool) -> np.ndarray:
        with Image.open(path) as source:
            image = source.convert("L")
            if self.image_size is not None:
                resampling = Image.Resampling.NEAREST if is_mask else Image.Resampling.BILINEAR
                image = image.resize((self.image_size, self.image_size), resampling)
            array = np.asarray(image, dtype=np.float32).copy()
        if is_mask:
            array = (array > 0).astype(np.float32)
        else:
            array /= 255.0
        return array[None, :, :]

    def __getitem__(self, index: int) -> dict[str, object]:
        record = self.records[index]
        window = self.window_by_record[(record.sequence, record.name)]
        frames = np.stack([self._load(item.image_path, False) for item in window], axis=0)
        center_position = self.window_size // 2
        image = frames[center_position]
        mask = self._load(record.mask_path, True)
        return {
            "frames": torch.from_numpy(frames),
            "image": torch.from_numpy(image),
            "mask": torch.from_numpy(mask),
            "sequence": record.sequence,
            "name": record.name,
            "frame_index": record.frame_index,
            "original_size": self._original_size(record.image_path),
        }

    @staticmethod
    def _original_size(path) -> tuple[int, int]:
        with Image.open(path) as image:
            return image.height, image.width

    def summary(self) -> dict[str, object]:
        return {
            "dataset": self.dataset_name,
            "root": str(self.root),
            "split": self.split,
            "samples": len(self.records),
            "sequences": {key: len(value) for key, value in self.sequence_records.items()},
            "split_info": self.split_info,
            "window_size": self.window_size,
            "boundary": self.boundary,
            "image_size": self.image_size,
        }
